  { "id": "stockpile", "name": "Stockpile", "description": "A depot of plates beside the start and extra ore in the core.",
    "prefabs": ["depot"], "items": { "copper_ore": 300, "iron_ore": 300 } },
  { "id": "both", "name": "Second scout and stockpile", "description": "Both of the above.",
    "prefabs": ["scout", "depot"], "items": { "copper_ore": 300, "iron_ore": 300 } }
]
