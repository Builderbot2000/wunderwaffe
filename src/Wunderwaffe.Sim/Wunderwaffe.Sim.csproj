<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure simulation library. Must never reference Godot: keeps it fast, deterministic and unit-testable. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wunderwaffe.Sim</RootNamespace>
  </PropertyGroup>

  <!-- Combat tests set hit points and loaded ammo directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Wunderwaffe.Sim.Tests" />
  </ItemGroup>

</Project>
