<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless external driver (NF-009): the sim's command + query API as JSON lines over stdin/stdout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wunderwaffe.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wunderwaffe.Sim\Wunderwaffe.Sim.csproj" />
  </ItemGroup>

</Project>
